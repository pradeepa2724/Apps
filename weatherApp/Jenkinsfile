pipeline{
    agent any
    tools{
        maven 'Maven3'
    }
    stages{
        stage('build'){
            steps{
             dir('weatherApp') {
                sh 'mvn clean package'
            }
            }
        }
        stage('docker build'){
            steps{
                dir('weatherApp'){
                sh 'docker build -t weatherapp:latest .'
            }
            }
        }
    }
}